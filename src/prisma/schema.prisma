generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DRIVER
  HEAD_OF_DEPARTMENT
  TRANSPORT_OFFICER
  ADA_DAHRM
  PROCUREMENT
}

enum FuelType {
  DIESEL
  PETROL
}

enum RequestStatus {
  PENDING_HEAD_APPROVAL
  HEAD_APPROVED
  HEAD_REJECTED
  PENDING_TRANSPORT_APPROVAL
  TRANSPORT_APPROVED
  TRANSPORT_REJECTED
  PENDING_DA_APPROVAL
  ADA_APPROVED
  ADA_REJECTED
  FULLY_APPROVED
  PENDING_FUEL_ISSUANCE
  COMPLETED
  CANCELLED
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGGED_IN
  USER_LOGGED_OUT
  USER_DEACTIVATED
  USER_ACTIVATED
  USER_ROLE_CHANGED
  USER_ACCOUNT_LOCKED
  USER_PASSWORD_CHANGED
  DRIVER_SUBMITTED_REQUEST
  HEAD_APPROVED_REQUEST
  HEAD_REJECTED_REQUEST
  TRANSPORT_APPROVED_REQUEST
  TRANSPORT_REJECTED_REQUEST
  ADA_APPROVED_REQUEST
  ADA_REJECTED_REQUEST
  FINAL_APPROVAL_COMPLETED
  FUEL_PERMIT_PRINTED
  FUEL_STATEMENT_PRINTED
  FUEL_ISSUED
  REQUEST_CANCELLED
}

model User {
  id               String          @id @default(cuid())
  employeeNumber   String          @unique
  firstName        String
  lastName         String
  title            String?
  email            String          @unique
  password         String
  phone            String?
  role             Role
  departmentId     String?
  isActive         Boolean         @default(true)
  lastLogin        DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil      DateTime?
  passwordChangedAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  department       Department?     @relation(fields: [departmentId], references: [id])
  fuelRequests     FuelRequest[]
  finalApprovals   FuelRequest[]  @relation("FinalApprover")
  approvals        Approval[]
  fuelIssuances    FuelIssuance[]
  notifications    Notification[]
  deviceTokens     DeviceToken[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]

  @@index([email])
  @@index([role])
  @@index([departmentId])
  @@index([lockedUntil])
}

model Department {
  id              String     @id @default(cuid())
  name            String     @unique
  description     String?
  headUserId      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  users           User[]
  vehicles        Vehicle[]
  fuelRequests    FuelRequest[]

  @@index([headUserId])
}

model Vehicle {
  id              String     @id @default(cuid())
  vehicleNumber   String     @unique
  gpsa            String
  fuelType        FuelType
  departmentId    String
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  department      Department @relation(fields: [departmentId], references: [id])
  fuelRequests    FuelRequest[]

  @@index([vehicleNumber])
  @@index([departmentId])
}

model FuelRequest {
  id                    String          @id @default(cuid())
  requestNumber         String          @unique
  driverId              String
  departmentId          String
  vehicleId             String
  fuelType              FuelType
  requestedLitres       Float
  approvedLitres        Float?
  issuedLitres          Float?
  gpsa                  String
  purpose               String
  kmFrom                Float
  kmTo                  Float
  kmUsed                Float
  lastFuelReceived      Float
  requestDate           DateTime        @default(now())
  status                RequestStatus   @default(PENDING_HEAD_APPROVAL)
  driverSignature       String
  rejectionReason       String?
  finalApproverId       String?
  finalApprovedAt       DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  driver                User            @relation(fields: [driverId], references: [id])
  department            Department      @relation(fields: [departmentId], references: [id])
  vehicle               Vehicle         @relation(fields: [vehicleId], references: [id])
  finalApprover         User?           @relation("FinalApprover", fields: [finalApproverId], references: [id])
  approvals             Approval[]
  fuelIssuance          FuelIssuance?
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@index([requestNumber])
  @@index([driverId])
  @@index([status])
  @@index([departmentId])
  @@index([vehicleId])
  @@index([finalApproverId])
  @@index([createdAt])
  @@index([driverId, status])
  @@index([departmentId, status])
  @@index([fuelType])
}

model Approval {
  id                  String          @id @default(cuid())
  requestId           String
  approverId          String
  stage               String
  approved            Boolean
  reason              String?
  litresApproved      Float?
  logbookNumber       String?
  logbookTo           String?
  designation         String
  signature           String
  approvedAt          DateTime        @default(now())

  request             FuelRequest     @relation(fields: [requestId], references: [id])
  approver            User            @relation(fields: [approverId], references: [id])

  @@index([requestId])
  @@index([approverId])
  @@unique([requestId, stage])
}

model FuelIssuance {
  id                  String          @id @default(cuid())
  requestId           String          @unique
  issuedBy            String
  fuelType            FuelType
  litresIssued        Float
  tokenNumber         String          @unique
  designation         String
  signature           String
  issuedAt            DateTime        @default(now())

  request             FuelRequest     @relation(fields: [requestId], references: [id])
  issuer              User            @relation(fields: [issuedBy], references: [id])

  @@index([requestId])
  @@index([tokenNumber])
}

model Notification {
  id                  String          @id @default(cuid())
  userId              String
  requestId           String?
  title               String
  message             String
  type                String
  isRead              Boolean         @default(false)
  readAt              DateTime?
  createdAt           DateTime        @default(now())

  user                User            @relation(fields: [userId], references: [id])
  request             FuelRequest?    @relation(fields: [requestId], references: [id])

  @@index([userId])
  @@index([requestId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model DeviceToken {
  id                  String          @id @default(cuid())
  userId              String
  fcmToken            String          @unique
  deviceType          String?
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user                User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([fcmToken])
  @@index([isActive])
}

model AuditLog {
  id                  String          @id @default(cuid())
  userId              String
  action              AuditAction
  requestId           String?
  previousStatus      RequestStatus?
  newStatus           RequestStatus?
  description         String
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime        @default(now())

  user                User            @relation(fields: [userId], references: [id])
  request             FuelRequest?    @relation(fields: [requestId], references: [id])

  @@index([userId])
  @@index([requestId])
  @@index([action])
  @@index([createdAt])
}

model RefreshToken {
  id                  String          @id @default(cuid())
  userId              String
  token               String          @unique
  expiresAt           DateTime
  isRevoked           Boolean         @default(false)
  createdAt           DateTime        @default(now())

  user                User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}
